
# 主Agent API Key（必填）
API_KEY=sk-xxxx
MAIN_MODEL=
API_BASE=

# Light Dream Agent （记忆整理；未填 Key/模型时回退到主 Agent 配置）
LIGHT_DREAM_API_KEY=
LIGHT_DREAM_MODEL=

# 文档分析子 Agent。未填时与主Agent共用同一API————不推荐这样做，会破坏KVCache，与项目初衷违背。
DOCS_AGENT_MODEL=
DOCS_AGENT_API_KEY=
DOCS_AGENT_API_BASE=

# Tavily API Key，必填。
TAVILY_API_KEY=

# 是否启用安全模式（开启后会执行一些安全限制，例如搜索工具仅访问白名单域名内的URL，可能会降低信息召回率，但可以增加信息来源的可靠性）。默认 false
# 可以在 backend/data/search_whitelist.json 中添加白名单域名
SEARCH_SAFE_MODE=false

# 上下文窗口大小（token）。用于压缩算法的判断等操作。默认为1M，根据模型而选择
MODEL_CONTEXT_WINDOW=1000000

# Redis默认工作于6379端口
REDIS_URL=redis://localhost:6379/0

# 工具结果缓存默认 TTL（秒）。默认3600s，适当增大可以增加缓存命中率。
TOOL_CACHE_DEFAULT_TTL_SECONDS=3600

# HITL工具审批最长等待（秒）；超时按拒绝处理。默认 10。
APPROVAL_TIMEOUT_SECONDS=10

# Worker 进程内并发消费者数量。默认为5，根据业务场景选择。
WORKER_COUNT=5

# 任务状态/事件流在 Redis 中的保留时间（秒）。默认 3600。
TASK_RESULT_TTL_SECONDS=3600

# 超时未ACK的任务可被认领的空闲阈值（毫秒）。默认 60000。
TASK_CLAIM_IDLE_MS=60000

# 【可选】LiteLLM进行Agent trace统计，默认 false
ENABLE_LLM_STATS=false
LITELLM_PROXY_URL=


# 安全审查（输入 / 流式输出 / 最终回复）
# 针对用户输入、实时流式输出、最终回复做安全检查，包括字符匹配和语义检测，可自由开关每一阶段的检测。
# 若启用语义检测，需在Python环境额外安装transformers、torch库，并配置HuggingFace API KEY
HF_TOKEN=

# 用户输入审查（请求进入 Agent 前）
SECURITY_QUERY_ENABLED=true
SECURITY_QUERY_KEYWORD=true
SECURITY_QUERY_SEMANTIC=false

# 流式输出审查（边生成边过滤）
SECURITY_REPLY_STREAM_ENABLED=true
SECURITY_REPLY_STREAM_KEYWORD=true
SECURITY_REPLY_STREAM_SEMANTIC=false

# 最终回复审查（整段完成后）
SECURITY_REPLY_ENABLED=true
SECURITY_REPLY_KEYWORD=true
SECURITY_REPLY_SEMANTIC=false

# 流式安全窗口大小与重叠（字符）。默认 64 / 16。WINDOW表示每次检测的窗口大小，太小可能导致语义被截断，进而检测效果下降，太大会降低流式传输效果。推荐使用默认值。OVERLAP表示两次语义检测重复的字符数，推荐设置为WINDOW的四分之一到二分之一。
SECURITY_STREAM_WINDOW=64
SECURITY_STREAM_OVERLAP=16

# 语义检测阈值（仅当开启语义检测时生效）
# 高于 block 直接拦截；介于 warn~block 记发送警告。默认 0.8 / 0.3
PROMPT_GUARD_BLOCK_THRESHOLD=0.8
PROMPT_GUARD_WARN_THRESHOLD=0.3


# 评测模式（仅供开发者调试使用，用于接入MedmemoryBench评测系统，默认为False）
# 打开后会关闭全部安全审查并影响部分Agent行为。
EVAL_MODE=false
